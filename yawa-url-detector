# ==========================================
# CYBERSECURITY DETECTION THREAD LOGIC
# ==========================================
def check_url_safety_worker():
    """Background thread worker that processes the API request without freezing the GUI"""
    
    # DEFENSIVE CHECK: Ensure API Key was successfully loaded into memory from .env
    if not API_KEY:
        root.after(0, lambda: messagebox.showerror(
            "Security Exception", 
            "Critical Fault: VirusTotal API Key was not detected.\n\n"
            "Please configure your local hidden '.env' file variable "
            "before executing target node validations."
        ))
        root.after(0, lambda: status_label.config(text="SYSTEM ERROR // Missing API Credentials", fg="#EF4444"))
        return

    target_url = url_input.get().strip()
    
    # Reset UI metrics to default scanning modes safely across thread boundaries
    root.after(0, lambda: safe_launch_button.pack_forget())
    root.after(0, lambda: breakdown_label.config(text=""))
    root.after(0, lambda: risk_bar.config(value=0))
    
    if not target_url:
        root.after(0, lambda: messagebox.showwarning("Buffer Error", "Please parse an input URL string before running analysis sequence."))
        root.after(0, lambda: status_label.config(text="SYSTEM IDLE // Standby for signature submission...", fg="#64748B"))
        return

    root.after(0, lambda: status_label.config(text="⚡ INJECTING QUERY: Extracting remote database metrics...", fg="#00F0FF"))

    # LOCAL DOMAIN EXTRACTION
    try:
        parsed_url = urlparse(target_url)
        if not parsed_url.scheme:
            parsed_url = urlparse("http://" + target_url)
            
        protocol = parsed_url.scheme.upper()
        domain = parsed_url.netloc if parsed_url.netloc else parsed_url.path.split('/')[0]
        path = parsed_url.path if parsed_url.path else "/"
        
        breakdown_text = f"⚙️ NETWORK METADATA PARSER:\n[ PROTOCOL ]: {protocol}\n[ TARGET DOMAIN ]: {domain}\n[ PATH DIRECTORY ]: {path}"
        root.after(0, lambda: breakdown_label.config(text=breakdown_text, fg="#E2E8F0"))
    except Exception:
        breakdown_text = "⚠️ PARSER FAULT: Link normalization failed."
        root.after(0, lambda: breakdown_label.config(text=breakdown_text, fg="#F59E0B"))

    # CORE API SCANNERS
    try:
        # Secure URL Identifier Transform
        try:
            url_id = base64.urlsafe_b64encode(target_url.encode()).decode().strip("=")
        except Exception as encode_err:
            root.after(0, lambda: status_label.config(text="ERROR: Base64 data parsing trace failure.", fg="#EF4444"))
            root.after(0, lambda: messagebox.showerror("Data Transform Fault", str(encode_err)))
            return
        
        headers = {
            "accept": "application/json",
            "x-apikey": API_KEY
        }
        
        response = requests.get(f"{API_URL}/{url_id}", headers=headers)
        
        if response.status_code == 200:
            data = response.json()
            stats = data['data']['attributes']['last_analysis_stats']
            malicious_count = stats.get('malicious', 0) + stats.get('suspicious', 0)
            harmless_count = stats.get('harmless', 0) + stats.get('undetected', 0)

            if malicious_count == 0:
                # Progress bar drops to 0 on safe validation metrics
                root.after(0, lambda: risk_bar.config(value=0))
                root.after(0, lambda: style.configure("Custom.Horizontal.TProgressbar", background="#10B981")) # Cyber Green
                
                result_text = f"🛡️ SECURE NODE VALIDATED\n\nThreat signatures verified negative across {harmless_count} global security nodes."
                root.after(0, lambda: status_label.config(text=result_text, fg="#10B981"))
                
                log_to_csv(target_url, malicious_count, harmless_count, "CLEAN/SAFE")
                root.after(0, lambda: safe_launch_button.pack(pady=15))
                
            elif 1 <= malicious_count <= 3:
                root.after(0, lambda: risk_bar.config(value=50))
                root.after(0, lambda: style.configure("Custom.Horizontal.TProgressbar", background="#F59E0B")) # Warning Amber
                
                result_text = f"⚠️ SUSPICIOUS ANOMALY DETECTED\n\nFlagged by {malicious_count} active database engines. Review integrity logs before access."
                root.after(0, lambda: status_label.config(text=result_text, fg="#F59E0B"))
                
                log_to_csv(target_url, malicious_count, harmless_count, "SUSPICIOUS")
                auto_save_threat_report(target_url, "SUSPICIOUS", malicious_count, harmless_count, breakdown_label.cget("text"))
                
            else:
                root.after(0, lambda: risk_bar.config(value=100))
                root.after(0, lambda: style.configure("Custom.Horizontal.TProgressbar", background="#EF4444")) # Critical Red
                
                result_text = f"🚨 CRITICAL THREAT WARNING // PHISHING BLOCKED\n\nPositive malware signatures found on {malicious_count} network scanners."
                root.after(0, lambda: status_label.config(text=result_text, fg="#EF4444"))
                
                log_to_csv(target_url, malicious_count, harmless_count, "MALICIOUS/PHISHING")
                auto_save_threat_report(target_url, "CRITICAL MALICIOUS / PHISHING", malicious_count, harmless_count, breakdown_label.cget("text"))
                
        elif response.status_code == 404:
            root.after(0, lambda: status_label.config(text="Unknown node sequence. Submitting to sandbox registry...", fg="#F59E0B"))
            
            submit_response = requests.post(API_URL, headers=headers, data={"url": target_url})
            if submit_response.status_code == 200:
                root.after(0, lambda: status_label.config(text="Sequence registered. Re-run scan in 10 seconds.", fg="#00F0FF"))
            else:
                root.after(0, lambda: status_label.config(text="Failed to bridge network link to cloud database.", fg="#EF4444"))
        else:
            root.after(0, lambda: status_label.config(text=f"DISRUPTION: Trace fault code [{response.status_code}]", fg="#EF4444"))

    except Exception as e:
        root.after(0, lambda: status_label.config(text="CONNECTION LOSS: Interface route failed.", fg="#EF4444"))
        root.after(0, lambda: messagebox.showerror("Network Fault", str(e)))

def check_url_safety_threaded():
    """Initializes verification sequence securely inside an independent background thread."""
    threading.Thread(target=check_url_safety_worker, daemon=True).start()

