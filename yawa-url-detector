def log_to_csv(url, malicious, harmless, verdict):
    try:
        try:
            with open(LOG_FILE, 'r') as f:
                has_header = True
        except FileNotFoundError:
            has_header = False

        with open(LOG_FILE, mode='a', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            if not has_header:
                writer.writerow(["Timestamp", "Target URL", "Malicious Engines", "Harmless Engines", "Verdict"])
            
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            writer.writerow([timestamp, url, malicious, harmless, verdict])
    except Exception as e:
        print(f"Logging System Error: {e}")

def auto_save_threat_report(url, verdict, malicious, harmless, metadata):
    """Automatically logs unsafe threat profiles to yawa.url.txt"""
    try:
        with open(AUTO_REPORT_FILE, mode='a', encoding='utf-8') as f:
            f.write("========================================================\n")
            f.write("          YAWA AUTOMATIC DETECTOR THREAT REPORT         \n")
            f.write(f"          TIMESTAMP: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
            f.write("========================================================\n")
            f.write(f"FLAGGED URL : {url}\n")
            f.write(f"SECURITY VERDICT : {verdict}\n")
            f.write(f"DETECTION MATRIX : Flagged by {malicious} engines (Clean: {harmless})\n\n")
            f.write("PARSED METADATA LOGS:\n")
            f.write(f"{metadata}\n")
            f.write("========================================================\n\n")
        print(f"[YAWA] Threat signature auto-saved to {AUTO_REPORT_FILE}")
    except Exception as e:
        print(f"Automatic Reporting System Error: {e}")

def open_browser_safely():
